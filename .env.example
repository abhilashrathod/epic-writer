# Copy to .env and fill in. Never commit .env.

# MongoDB connection string. Locally this is the single-node replica set from docker-compose
# (transactions need a replica set; port 27018 avoids clashing with a host-installed mongod).
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
# Database name inside the cluster.
MONGODB_DB=epic-writer

# Auth.js session/JWT secret. Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret
# GitHub OAuth app client ID and secret (https://github.com/settings/developers).
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# Set to true when self-hosting (Docker, a VPS) so Auth.js trusts the Host header. Not needed locally.
# AUTH_TRUST_HOST=true
# The only GitHub login allowed to sign in.
ALLOWED_GITHUB_LOGIN=your-github-username

# Encrypts users' AI provider keys (AES-256-GCM). Exactly 32 bytes, base64. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=your-32-byte-base64-secret

# Cloudflare R2 (unused until uploads ship).
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket

# Identifies this worker process in jobs.lockedBy. Any unique string per worker.
WORKER_ID=worker-1
